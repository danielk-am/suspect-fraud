---
interface Props {
  label: string;
  items: {label: string; href: string; icon?: 'overview' | 'details' | 'build'; current?: boolean}[];
}
const {label, items} = Astro.props;
const paths = {
  overview: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  details: 'M8 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-3M8 2h8v4H8zM7 11h10M7 16h6',
  build: 'm8 7-5 5 5 5m8-10 5 5-5 5M14 4l-4 16',
};
---
<nav class="af-nav-section" aria-label={label}>
  <h2>{label}</h2>
  <div class="grid gap-1">
    {items.map(item => <a class="af-nav-item rounded-lg px-3 py-2 transition-colors" href={item.href} aria-current={item.current ? 'page' : undefined}>
      <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[item.icon || 'overview']}/></svg>
      <span>{item.label}</span>
      <span class="af-nav-current" aria-hidden="true"></span>
    </a>)}
  </div>
</nav>
