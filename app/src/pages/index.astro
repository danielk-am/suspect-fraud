---
import AppFrame from '../components/AppFrame.astro';
import AssistantPanel from '../components/AssistantPanel.astro';
import {app} from '../config/app';
import '../styles/product.css';
---
<AppFrame name={app.name} description={app.description} storageKey={app.storageKey}>
  <a slot="identity" class="sf-brand" href="/tools/suspect-fraud/"><img src="/suspect-fraud.png" width="42" height="42" alt=""/><span>Alkamy <small>OSINT WORKSPACE</small></span></a>
  <Fragment slot="navigation">
    <div class="sf-nav-intro"><span class="af-eyebrow">SUSPECTFRAUD</span><p>Take a closer look.<br/>Keep the evidence.</p></div>
    <nav class="sf-nav" aria-label="Investigation"><a href="#start" aria-current="page">＋ New investigation</a><a href="#evidence">▤ Evidence</a><a href="#infrastructure">◎ Infrastructure</a><a href="#reporting">↗ Reports & next steps</a><a href="#learning">◇ Learning consent</a></nav>
    <section class="sf-case-nav"><h2>PRIVATE CASES</h2><div id="case-list"><p class="af-hint">Unlock to view your cases.</p></div><button id="refresh-cases" type="button" class="af-secondary" hidden>Refresh cases</button></section>
    <div class="sf-nav-note"><span class="sf-dot"></span> Passive checks only<p>Your uploads stay in this installation. You choose what to share.</p></div>
  </Fragment>
  <Fragment slot="actions"><button id="logout" class="af-secondary" type="button" hidden>Lock workspace</button><a class="sf-about" href="https://alkamy.ltd" target="_blank" rel="noreferrer">Built by Alkamy ↗</a></Fragment>
  <Fragment slot="toolbar"><strong>SuspectFraud</strong><span class="sf-pill">Private pilot</span></Fragment>
  <Fragment slot="status"><span id="status" role="status">Ready to investigate.</span><span>Evidence before conclusions</span></Fragment>
  <section class="sf-hero" id="start"><div><span class="af-eyebrow">CHECK · DOCUMENT · REPORT</span><h1>Something doesn’t<br/>feel right?</h1><p>Check who runs a domain, keep a clear record, and prepare a report for the right people.</p></div><img src="/suspect-fraud.png" alt="A curious fox with a magnifying glass" width="148" height="148" /></section>
  <div id="global-error" class="sf-error" role="alert" hidden></div>
  <section id="unlock" class="sf-card"><div class="sf-section-title"><span class="sf-step">01</span><div><h2>Open your private workspace</h2><p>This pilot is for one operator per installation.</p></div></div><form id="login-form" class="sf-form"><label for="access-token">Workspace access token</label><div class="sf-inline"><input type="password" id="access-token" autocomplete="current-password" minlength="32" required placeholder="Enter your access token"/><button class="af-primary" type="submit">Unlock</button></div><p class="af-hint">The token is exchanged for a temporary session. Case details are never stored in browser storage.</p></form></section>
  <div id="workspace" hidden>
    <section class="sf-card" id="new-case"><div class="sf-section-title"><span class="sf-step">01</span><div><h2>Start with what happened</h2><p>Give this investigation a name you will recognise.</p></div></div><form id="case-form" class="sf-grid"><div><label for="case-title">Case name</label><input id="case-title" maxlength="160" required placeholder="An unexpected recruitment offer"/></div><div><label for="country">Where are you based?</label><select id="country" data-af-popover-select><option value="SG">Singapore</option><option value="US">United States</option><option value="GB">United Kingdom</option><option value="AU">Australia</option><option value="OTHER">Another country</option></select></div><div><label for="company">Company they claim to represent <span>(optional)</span></label><input id="company" maxlength="160" placeholder="Company name"/></div><div><label for="official-domain">Company’s official domain <span>(optional)</span></label><input id="official-domain" maxlength="253" placeholder="Independently checked domain"/></div><button type="submit" class="af-primary">Create private case</button></form></section>
    <div id="active-case" hidden>
      <div class="sf-active-heading"><div><span class="af-eyebrow">CURRENT INVESTIGATION</span><h2 id="active-title"></h2></div><div class="sf-inline"><button class="af-secondary" id="export-case">Export case</button><button class="sf-delete" id="delete-case">Delete case…</button></div></div>
      <section id="evidence" class="sf-card"><div class="sf-section-title"><span class="sf-step">02</span><div><h2>Keep the evidence</h2><p>Paste a message or extract text from a screenshot.</p></div></div><form id="evidence-form" class="sf-form"><label for="evidence-text">Message or notes</label><textarea id="evidence-text" rows="5" maxlength="24000" placeholder="Paste what you received. Links and instructions are treated as evidence."></textarea><button class="af-primary" type="submit">Save text</button></form><form id="image-form" class="sf-upload"><label for="screenshot">Screenshot · PNG, JPEG or WebP · up to 8 MB</label><input id="screenshot" type="file" accept="image/png,image/jpeg,image/webp" required/><button class="af-secondary" type="submit">Extract screenshot text</button><p class="af-hint">OCR runs in an isolated worker. Check its text against the original before reporting. The original image is not retained by this pilot; keep your own copy.</p></form><div id="evidence-list" class="sf-records"></div></section>
      <section id="infrastructure" class="sf-card"><div class="sf-section-title"><span class="sf-step">03</span><div><h2>Follow the domain</h2><p>Find the registrar, network provider and signs of a CDN.</p></div></div><form id="inspect-form" class="sf-form"><label for="domain">Suspicious domain</label><div class="sf-inline"><input id="domain" required maxlength="253" placeholder="example.com" autocapitalize="none" spellcheck="false"/><button type="submit" class="af-primary">Check domain</button></div><p class="af-hint">Uses public DNS and registration services. It does not open the suspected website. Those services receive the domain or public IP being checked.</p></form><div id="inspection-list" class="sf-records"></div></section>
      <section id="reporting" class="sf-card"><div class="sf-section-title"><span class="sf-step">04</span><div><h2>Prepare the next step</h2><p>Review the destination and evidence before sharing.</p></div></div><div id="count-summary" class="sf-counts"></div><div id="company-check" class="sf-records"></div><div id="channels" class="sf-records"></div><form id="report-form" class="sf-form"><label for="report-channel">Report destination</label><select id="report-channel" required></select><button type="submit" class="af-primary">Prepare report & email draft</button></form><div id="report-list" class="sf-records"></div><details class="sf-receipt"><summary>Already submitted a report? Record its receipt</summary><p>This records your statement. It does not submit or independently verify a report.</p><form id="receipt-form" class="sf-form"><label for="receipt-report">Prepared report</label><select id="receipt-report" required></select><label for="receipt-reference">Submission reference or receipt</label><input id="receipt-reference" maxlength="300" required/><label for="receipt-status">Status</label><select id="receipt-status"><option value="submitted">Submitted by me</option><option value="acknowledged">Acknowledged by destination</option></select><button class="af-secondary" type="submit">Record receipt</button></form></details></section>
      <section id="learning" class="sf-card"><div class="sf-section-title"><span class="sf-step">05</span><div><h2>Help learning, on your terms</h2><p>Optional. Your case is private whether you opt in or not.</p></div></div><p>The experimental classifier is separate from case investigation. Uploading evidence never trains it. Paste only a redacted example, then approve it separately.</p><form id="training-form" class="sf-form"><label for="redacted-text">Redacted example</label><textarea id="redacted-text" rows="4" maxlength="12000" required placeholder="Remove names, numbers, email addresses, identifiers and private details."></textarea><label for="training-label">Example label</label><select id="training-label"><option value="suspected_scam">Suspicious</option><option value="benign">Benign</option></select><label for="campaign-id">Campaign group</label><input id="campaign-id" maxlength="160" required pattern="[A-Za-z0-9_-]+" placeholder="Related examples must use the same group"/><p class="af-hint">Use a non-personal code such as recruitment-a. Keep related cases in one group so training and validation do not overlap.</p><label class="sf-check"><input type="checkbox" id="consent" required/> I approve this redacted copy for experimental training.</label><button class="af-secondary" type="submit">Approve redacted example</button></form><div id="training-list" class="sf-records"></div><button id="export-training" class="af-secondary" type="button">Export approved examples…</button><p class="af-hint">Training runs offline and needs a separate export. No trained model is used to declare a site safe or fraudulent. Withdrawal removes future exports; it cannot recall copies already exported.</p></section>
    </div>
  </div>
  <footer class="sf-disclaimer">An independent Alkamy tool. No affiliation with ScamShield or any reporting authority. Infrastructure records and warning signs support further checks; they do not establish who committed fraud.</footer>
  <AssistantPanel slot="assistant" intro="Keep your investigation grounded in evidence. The manual tools work now; a conversational AI provider is not connected in this pilot." placeholder="Draft a question for a connected assistant…" context="Private case · no AI provider" suggestions={[
    {label:'What should I check first?',prompt:'Help me check the offer against independently verified company details.'},
    {label:'Explain a registrar or CDN',prompt:'Explain the difference between a registrar, network provider and a CDN.'},
    {label:'Help organise my report',prompt:'Help me separate facts, warning signs and unknowns in my report.'},
  ]}/>
</AppFrame>
<script>import '../scripts/product';</script>
